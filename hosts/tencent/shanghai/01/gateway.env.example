# Inventory-only host. Add services to host.json and their domain variables here before deployment.
# Copy to /opt/gateway/gateway.env, chmod 600; retain real volume names on existing hosts.
CADDY_IMAGE=registry.cn-hangzhou.aliyuncs.com/example/caddy@sha256:REPLACE_WITH_DIGEST
ACME_EMAIL=admin@example.com
CADDY_DATA_VOLUME=tencent-shanghai-01-caddy-data
CADDY_CONFIG_VOLUME=tencent-shanghai-01-caddy-config
