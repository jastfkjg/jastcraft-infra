# Use the existing echooo release's CADDY_IMAGE digest for the initial migration.
# Future gateway upgrades are managed separately from business deployments.
CADDY_IMAGE=registry.example.com/infra/caddy@sha256:REPLACE_WITH_DIGEST
# Plain hostname for HTTPS. If echooo currently uses HTTP, preserve its exact
# origin with http://IP here during migration; change to HTTPS separately.
ECHOOO_ADDRESS=echooo.example.com
SHADOWTABLE_DOMAIN=table.example.com
ACME_EMAIL=admin@example.com
# Discover actual names with docker inspect; never assume these examples match.
CADDY_DATA_VOLUME=echooo_caddy_data
CADDY_CONFIG_VOLUME=echooo_caddy_config
