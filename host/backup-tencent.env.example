# For a future SQLite service on Tencent Cloud; keep credentials in root's COSCLI configuration.
# Configure the real bucket and this service's prefix before enabling any backup timer.
BACKUP_CLOUD=tencent
BACKUP_SERVICE=shadowtable
BACKUP_DESTINATION=cos://example-backups-1250000000/shadowtable/prod
BACKUP_COS_ENDPOINT=cos.ap-shanghai.myqcloud.com
